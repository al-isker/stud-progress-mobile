{
	"expo": {
		"name": "Stud Progress",
		"slug": "stud-progress",
		"scheme": "stud-progress",
		"version": "1.0.0",
		"orientation": "portrait",
		"icon": "./assets/app-icon.png",
		"userInterfaceStyle": "light",
		"newArchEnabled": true,
		"splash": {
			"image": "./assets/app-splash-icon.png",
			"imageWidth": 300,
			"resizeMode": "contain",
			"backgroundColor": "#4b0aff"
		},
		"android": {
			"adaptiveIcon": {
				"foregroundImage": "./assets/app-adaptive-icon.png",
				"backgroundColor": "#4b0aff"
			},
			"package": "com.alisker.studprogress",
			"googleServicesFile": "./google-services.json"
		},
		"ios": {
			"supportsTablet": true,
			"googleServicesFile": "./GoogleService-Info.plist"
		},
		"plugins": [
			[
				"expo-router",
				{
					"root": "./app"
				}
			]
		],
		"extra": {
			"router": {
				"origin": false,
				"root": "./app"
			},
			"eas": {
				"projectId": "013a1449-dd23-47b2-9b90-2bcf54eec682"
			}
		},
		"owner": "al-isker"
	}
}
