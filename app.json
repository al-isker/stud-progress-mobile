{
	"expo": {
		"name": "Stud Progress",
		"slug": "stud-progress-mobile",
		"owner": "stud-progress",
		"scheme": "stud-progress",
		"version": "1.0.1",
		"orientation": "portrait",
		"icon": "./assets/app-icon.png",
		"userInterfaceStyle": "light",
		"newArchEnabled": true,
		"splash": {
			"image": "./assets/app-splash-icon.png",
			"resizeMode": "contain",
			"backgroundColor": "#4b0aff"
		},
		"android": {
			"package": "com.alisker.studprogress",
			"adaptiveIcon": {
				"foregroundImage": "./assets/app-adaptive-icon.png",
				"backgroundColor": "#4b0aff"
			},
			"googleServicesFile": "./google-services.json"
		},
		"ios": {
			"bundleIdentifier": "com.alisker.studprogress",
			"supportsTablet": true,
			"infoPlist": {
				"ITSAppUsesNonExemptEncryption": false
			}
		},
		"plugins": [
			[
				"expo-router",
				{
					"root": "./app"
				}
			]
		],
		"extra": {
			"router": {
				"origin": false,
				"root": "./app"
			},
			"eas": {
				"projectId": "7c0396fc-ebd2-4d27-aa61-243879832b4a"
			}
		}
	}
}
